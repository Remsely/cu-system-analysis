@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam wrapWidth 230
skinparam maxMessageSize 95
skinparam sequence {
  ParticipantBackgroundColor #EEF3FF
  ParticipantBorderColor #3B5BDB
  ActorBackgroundColor #EEF3FF
  LifeLineBorderColor #888888
}
autonumber
actor "Пользователь" as U
participant "Браузерный клиент" as C
participant "Наш SSE API" as A
participant "Поисковый компонент" as S
database "Каталог и геоданные" as K
participant "Гостиничные системы" as H

title SSE: предварительные данные и итог
U -> C : задать поездку и фильтры; запустить поиск
C -> C : проверить корректность формы
C -> A : EventSource: GET /v1/hotel-offers/stream\nусловия в параметрах URL
A -> A : проверить параметры
A --> C : 200 OK; Content-Type: text/event-stream\nCache-Control: no-store; ответ остаётся открытым
A ->> S : запустить поиск
S -> K : отобрать кандидатов по городу, метро\nи всем условиям достопримечательностей
K --> S : отели-кандидаты
loop для каждого необходимого гостиничного источника
  S -> H : запросить цены и наличие\nна выбранные даты и число гостей
  H --> S : данные источника
  S -> S : применить фильтры завтрака и цены
  S ->> A : предварительные совпадения
  A ->> C : event: results\ndata: JSON предварительных совпадений
  C ->> U : показать предварительные предложения\nи состояние продолжающегося поиска
end
S -> S : сформировать итоговую выдачу
opt совпадений нет
  S -> K : до 10 ближайших отелей\nс указанием нарушенных фильтров
  K --> S : рекомендации
end
S ->> A : итоговая выдача\nлибо сообщение и рекомендации
A ->> C : event: completed\ndata: JSON итогового результата
C -> C : заменить предварительные данные итогом;\nEventSource.close()
C --> U : показать завершённый поиск
@enduml
