@startuml
skinparam shadowing false
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam wrapWidth 220
skinparam activity {
  BackgroundColor #EEF3FF
  BorderColor #3B5BDB
}
skinparam swimlaneTitleFontStyle bold

title Диаграмма деятельности: поиск и бронирование номера в отеле

|Пользователь|
start
:Указать город, даты\nи число гостей;

:Задать фильтры (необязательно): метро (мин пешком),\nдостопримечательности (мин, способ),\nзавтрак, диапазон цены за ночь;
repeat
  |Система|
  :Отобрать отели города по справочнику: метро\n<= N мин пешком, достопримечательности\n<= M мин выбранным способом;
  :Запросить у отелей-кандидатов цены и наличие\nномеров на выбранные даты и число гостей;
  |Отель|
  :Вернуть цены и доступные номера;
  |Система|
  :Отфильтровать по завтраку, диапазону цены\nи наличию свободных номеров;
  |Пользователь|
backward :Получить сообщение и до 10 ближайших отелей\nс указанием нарушенного фильтра, смягчить фильтры;
repeat while (Подходящих отелей нет?) is (да) not (нет)
|Система|
:Показать выдачу с ценами\nза выбранные даты;

|Пользователь|
:Выбрать номер из выдачи;
|Система|
:Показать информацию о номере и стоимость\nпроживания за период (цена, завтрак, расстояния);
repeat
  |Пользователь|
  if (Бронировать по показанной цене?) then (нет)
    #FFE3E3:Отказаться от бронирования;
    stop
  else (да)
  endif
  |Система|
  :Запросить у отеля резерв номера\nпо показанной цене;
  |Отель|
  :Проверить наличие номера и цену,\nпри совпадении зарезервировать;
  |Система|
  if (Номер свободен?) then (нет)
    #FFE3E3:Сообщить «Номер уже забронирован»,\nпредложить вернуться к выдаче;
    stop
  else (да)
  endif
|Система|
backward :Предупредить:\nцена изменилась;
repeat while (Цена изменилась?) is (да) not (нет)

:Создать бронь, присвоить номер брони\nи сохранить событие для отправки письма;
fork
  |Пользователь|
  :Увидеть экран с номером брони;
fork again
  |Система|
  :Отправить email-подтверждение;\nпри ошибке до 5 повторов через 1, 2, 4, 8, 15 мин,\nкаждый сбой записать в лог;
  |Почтовый сервис|
  :Доставить письмо пользователю;
  |Система|
end fork
|Пользователь|
stop
@enduml
