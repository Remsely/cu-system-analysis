@startuml
skinparam shadowing false
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam wrapWidth 220
title Диаграмма деятельности: поиск и бронирование номера в отеле
skinparam activity {
  BackgroundColor #EEF3FF
  BorderColor #3B5BDB
}
skinparam swimlaneTitleFontStyle bold

|Пользователь|
start
:Указать город, даты\nи число гостей;

repeat
  |Пользователь|
  if (Нужны фильтры?) then (да)
    :Задать фильтры: метро (мин пешком),\nдостопримечательности (мин, способ),\nзавтрак, диапазон цены за ночь;
  else (нет)
  endif
  |Система|
  :Запросить цены и наличие\nномеров у отелей города;
  |Отель|
  :Вернуть цены и доступные номера;
  |Система|
  :Применить все заданные фильтры\nодновременно (логическое «И»):\nметро ≤ N мин пешком, достопримечательности\n≤ M мин выбранным способом, завтрак,\nцена за ночь в диапазоне;
  if (Есть подходящие отели?) then (да)
    :Показать выдачу с ценами\nза выбранные даты;
  else (нет)
    :Показать сообщение и до 10 ближайших\nотелей с указанием нарушенного фильтра;
    |Пользователь|
    if (Смягчить фильтры?) then (да)
    else (нет)
      #FFE3E3:Поиск прекращён;
      stop
    endif
  endif
repeat while (Выдача была пустой?) is (да, фильтры\nизменены) not (нет)

repeat
  |Пользователь|
  :Выбрать отель и номер;
  :Нажать «Подтвердить бронирование»;
  |Система|
  :Повторно запросить цену\nи наличие номера;
  |Отель|
  :Вернуть актуальную цену\nи статус номера;
  |Система|
  if (Номер ещё свободен?) then (да)
    if (Цена изменилась?) then (да)
      :Показать предупреждение:\nпрежняя и новая цена;
      |Пользователь|
      if (Согласен с новой ценой?) then (да)
        :Подтвердить новую цену;
      else (нет)
        #FFE3E3:Бронирование отменено;
        stop
      endif
      |Система|
    else (нет)
    endif
    :Создать бронь и присвоить\nномер брони;
  else (нет)
    :Показать сообщение\n«Номер уже забронирован»;
    |Пользователь|
    if (Выбрать другой номер?) then (да)
    else (нет)
      #FFE3E3:Бронирование отменено;
      stop
    endif
  endif
repeat while (Бронь не создана?) is (да) not (нет)

|Система|
fork
  |Пользователь|
  :Увидеть экран с номером брони;
fork again
  |Система|
  :Поставить отправку\nemail в очередь;
  |Почтовый сервис|
  repeat
    :Отправить email-подтверждение;
  repeat while (Ошибка отправки и\nповторов < 5?) is (да, пауза\n1/2/4/8/15 мин) not (нет)
  if (Письмо отправлено?) then (да)
  else (нет)
    |Система|
    #FFE3E3:Записать сбой отправки в лог;
  endif
fork again
  |Отель|
  :Получить уведомление\nо новой брони;
end fork
|Пользователь|
stop
@enduml
