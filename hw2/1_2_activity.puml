@startuml
skinparam shadowing false
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam roundCorner 8
skinparam ArrowColor #333333
skinparam wrapWidth 220
skinparam activity {
  BackgroundColor #EEF3FF
  BorderColor #3B5BDB
}
skinparam swimlaneTitleFontStyle bold

title Диаграмма деятельности: поиск и бронирование номера в отеле

|Пользователь|
start
:Указать город, даты\nи число гостей;

if (Нужны фильтры?) then (да)
  :Задать фильтры: метро (мин пешком),\nдостопримечательности (мин, способ),\nзавтрак, диапазон цены за ночь;
else (нет)
endif
|Система|
:Отобрать отели города по справочнику: метро\n<= N мин пешком, достопримечательности\n<= M мин выбранным способом;
:Запросить у отелей-кандидатов цены и наличие\nномеров на выбранные даты и число гостей;
|Отель|
:Вернуть цены и доступные номера;
|Система|
:Отфильтровать по завтраку, диапазону цены\nи наличию свободных номеров;
while (Подходящих отелей нет?) is (да)
  :Показать сообщение и до 10 ближайших\nотелей с указанием нарушенного фильтра;
  |Пользователь|
  if (Смягчить фильтры?) then (да)
    :Изменить фильтры;
    |Система|
    :Повторить поиск и отбор\nс новыми фильтрами;
  else (нет)
    #FFE3E3:Поиск прекращён;
    stop
  endif
endwhile (нет)
|Система|
:Показать выдачу с ценами\nза выбранные даты;

repeat
  |Пользователь|
  :Выбрать отель и номер из выдачи;
  |Система|
  :Показать информацию о номере и стоимость\nпроживания (цена, завтрак, расстояния);
  |Пользователь|
  if (Бронировать этот номер?) then (да)
    repeat
      |Пользователь|
      :Подтвердить бронирование\n(при повторе - по новой цене);
      |Система|
      :Запросить резерв номера\nпо ожидаемой цене;
      |Отель|
      :Проверить наличие и цену;\nпри успехе зарезервировать номер;
      |Система|
      if (Номер свободен?) then (да)
        if (Цена совпадает?) then (да)
          :Создать бронь и присвоить\nномер брони;
        else (нет)
          :Показать предупреждение:\nпрежняя и новая цена;
          |Пользователь|
          if (Согласен с новой ценой?) then (да)
          else (нет)
            #FFE3E3:Бронирование отменено;
            stop
          endif
        endif
      else (нет)
        :Показать сообщение\n«Номер уже забронирован»;
        |Пользователь|
        if (Выбрать другой номер?) then (да)
        else (нет)
          #FFE3E3:Бронирование отменено;
          stop
        endif
      endif
    repeat while (Цена изменилась,\nпользователь согласен?) is (да) not (нет)
  else (нет)
    if (Посмотреть другой номер?) then (да)
    else (нет)
      #FFE3E3:Бронирование отменено;
      stop
    endif
  endif
repeat while (Бронь не создана?) is (да) not (нет)

|Система|
fork
  |Пользователь|
  :Увидеть экран с номером брони;
fork again
  |Система|
  :Поставить отправку\nemail в очередь;
  |Почтовый сервис|
  repeat
    :Отправить email-подтверждение;
  repeat while (Ошибка отправки и\nповторов < 5?) is (да, пауза\n1/2/4/8/15 мин) not (нет)
  if (Письмо отправлено?) then (да)
  else (нет)
    |Система|
    #FFE3E3:Записать сбой отправки в лог;
  endif
end fork
|Пользователь|
stop
@enduml
